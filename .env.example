# OpenRouter — used to call the LLM that reads the handwriting (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# The Postgres the ocr_dhammakaya schema is created in
DATABASE_URL=postgresql://user:password@host/dbname
DB_SCHEMA=ocr_dhammakaya

# Model chosen from the results in bench/report.md
OCR_MODEL=google/gemini-3-flash-preview
# Fields scoring below this confidence are routed into the review queue
CONFIDENCE_THRESHOLD=0.85

# Exchange rate used to display AI spend in Thai baht
USD_THB=33

# Timezone used for display and for day boundaries on the dashboard. The Render server runs UTC,
# so leaving this unset puts every time on the site 7 hours behind Thai local time.
APP_TIMEZONE=Asia/Bangkok

# --- login ---
# Generate a hash with:  python -m ocrslip.auth hash '<password>'
# then paste the result here. Never put a real password in as plaintext.
SECRET_KEY=generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
USER_USERNAME=staff
USER_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
# The labelling account: sees only upload and the review queue, never the data table,
# the dashboard, the team roster or search
APPROVE_USERNAME=approve
APPROVE_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
# Set true when running behind HTTPS (on Render, for instance)
COOKIE_SECURE=false

# --- the self-service entry form (/in) ---
# The passcode a staff member types to close the form = their attestation that they saw this car
# parked. Leaving it unset disables /in entirely. Rotate it whenever you suspect it has leaked.
ENTRY_PASSWORD=
# Comma-separated building and floor choices for the form. These are only defaults: what is
# actually in use is editable on the /settings page (admin) and takes effect immediately with
# no restart.
ENTRY_BUILDINGS=อาคาร 1,อาคาร 2,อาคาร 3,อาคาร 4,ลานจอดรอบนอก
ENTRY_FLOORS=ชั้น 1,ชั้น 2,ชั้น 3,ชั้น 4,ชั้น 5,ชั้น 6,ลานพื้นราบ
