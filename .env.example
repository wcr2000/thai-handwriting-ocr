# OpenRouter — ใช้เรียก LLM อ่านลายมือ (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Postgres ที่จะสร้าง schema ocr_dhammakaya ลงไป
DATABASE_URL=postgresql://user:password@host/dbname
DB_SCHEMA=ocr_dhammakaya

# model ที่เลือกจากผล bench/report.md
OCR_MODEL=google/gemini-3-flash-preview
# field ที่ confidence ต่ำกว่านี้จะถูกส่งเข้าคิวตรวจสอบ
CONFIDENCE_THRESHOLD=0.85

# อัตราแลกเปลี่ยนสำหรับแสดงค่าใช้จ่าย AI เป็นบาท
USD_THB=33

# --- ระบบล็อกอิน ---
# สร้าง hash ด้วย:  python -m ocrslip.auth hash 'รหัสผ่านที่ต้องการ'
# แล้วเอาค่าที่ได้มาใส่ตรงนี้ (ห้ามใส่รหัสผ่านจริงเป็น plaintext)
SECRET_KEY=สุ่มด้วย python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
USER_USERNAME=staff
USER_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
# บัญชีคนทำ label: เห็นแค่หน้าอัปโหลดกับคิวตรวจสอบ ไม่เห็นตารางข้อมูล/สรุป/รายชื่อทีม/ค้นหา
APPROVE_USERNAME=approve
APPROVE_PASSWORD_HASH=scrypt$16384$8$1$xxxxx$xxxxx
# ตั้งเป็น true เมื่อรันหลัง HTTPS (เช่นบน Render)
COOKIE_SECURE=false
