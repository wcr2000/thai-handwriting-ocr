# --- secrets and machine-local values ---
.env
.env.*
!.env.example

# --- virtualenv / git ---
.venv
venv
.git
.gitignore
.github

# --- real data: must never end up in the image ---
example/
bench/out/
*.heic
*.HEIC

# --- not needed at runtime ---
bench/
tests/
db/*.md
start-project.py
README.md
LICENSE
Dockerfile
.dockerignore
render.yaml

# --- cache / build artifact ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
build/
dist/
*.egg-info/

# --- editor / OS ---
.idea/
.vscode/
.DS_Store
*.swp

# --- temporary files ---
scratch/
scratch*
tmp/
*.log
*.tmp
*.bak
